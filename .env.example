# GEMINI_API_KEY: Required for Gemini AI prompt analysis & expressive TTS generation.
# Set this in AI Studio Secrets or Vercel Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: Required for persistent PostgreSQL storage on Vercel (Neon, Supabase, Vercel Postgres).
# Also accepts POSTGRES_URL, POSTGRES_PRISMA_URL, or SUPABASE_DB_URL.
# When omitted in local development, local SQLite (./data/voiceprompt.db) is used automatically.
DATABASE_URL="MY_DATABASE_URL"

# AUTH_SECRET: Strong random secret (16+ chars) used to sign authentication tokens.
# Recommended in Vercel Environment Variables so sessions remain consistent across deployments.
AUTH_SECRET="MY_AUTH_SECRET"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
